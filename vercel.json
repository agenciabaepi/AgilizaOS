{
  "version": 2,
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/liberar-assinaturas",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/lembrete-assinatura",
      "schedule": "0 11 * * *"
    }
  ],
  "regions": ["gru1"],
  "build": {
    "env": {
      "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
      "PUPPETEER_EXECUTABLE_PATH": "/opt/render/project/.chromium/chromium"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "beta": true
    }
  }
}


